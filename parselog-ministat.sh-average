# Проверяем, передан ли файл
if [ -z "$1" ]; then
        echo "Использование: $0 <путь_к_логу_h1load>" >&2
        exit 1
fi

# AWK парсит лог, убирает прогрев/конец, конвертирует суффиксы и считает среднее
awk '
    # Пропускаем комментарии
    /^#/ { next }

    # Работаем только со строками, где есть данные (больше 10 полей)
    # и игнорируем секцию перцентилей (в ней меньше полей)
    NF >= 12 {
        rps = $8

        # Нам нужны только боевые метрики. Если RPS равен "0.00", пропускаем строку
        if (rps == "0.00" || rps == "0") next

        # Конвертируем буквенные суффиксы в чистые числа
        if (rps ~ /k$/) { sub(/k$/, "", rps); rps = rps * 1000 }
        else if (rps ~ /M$/) { sub(/M$/, "", rps); rps = rps * 1000000 }

        # Сохраняем значения в массив
        lines[count++] = rps
    }

    END {
        # Если данных вообще нет, выводим 0 и выходим
        if (count == 0) {
            print "0"
            exit
        }

        warmup = 5
        cooldown = 5

        sum = 0
        total_elements = 0

        if (count <= (warmup + cooldown + 3)) {
            # Если лог слишком короткий, считаем по всем элементам
            for (i = 0; i < count; i++) {
                sum += lines[i]
                total_elements++
            }
        } else {
            # Считаем без прогрева и спада
            for (i = warmup; i < (count - cooldown); i++) {
                sum += lines[i]
                total_elements++
            }
        }

        # Выводим среднее значение как строго целое число
        if (total_elements > 0) {
            printf "%d\n", sum / total_elements
        } else {
            print "0"
        }
    }
' "$1"
