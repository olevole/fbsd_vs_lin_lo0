#!/bin/sh

# Проверяем, передан ли файл
if [ -z "$1" ]; then
        echo "Использование: $0 <путь_к_логу_h1load>" >&2
        exit 1
fi

# AWK парсит лог, убирает прогрев/конец, конвертирует суффиксы и считает среднее
awk '
    # Если дошли до секции перцентилей, взводим флаг и пропускаем всё до конца файла
    /^#======= Percentiles/ { skip = 1; next }
    skip { next }

    # Пропускаем обычные комментарии
    /^#/ { next }

    # Работаем только со строками основных метрик
    NF >= 12 {
        rps = $8

        # Нам нужны только боевые метрики. Если RPS равен 0, пропускаем строку
        if (rps == 0.00 || rps == 0 || rps == "0.00") next

        # Обработка формата с "k" внутри (например, 69k2 -> 69.2 * 1000 = 69200)
        if (rps ~ /k/) {
            split(rps, parts, "k")
            dec = parts[2] ? parts[2] / (10 ^ length(parts[2])) : 0
            rps = (parts[1] + dec) * 1000
        } 
        # Обработка формата с "M" внутри (например, 9M75 -> 9.75 * 1000000)
        else if (rps ~ /M/) {
            split(rps, parts, "M")
            dec = parts[2] ? parts[2] / (10 ^ length(parts[2])) : 0
            rps = (parts[1] + dec) * 1000000
        }

        # Приводим к чистому числу (убираем точку у значений вида "398.")
        rps = int(rps)

        # Сохраняем значения в массив
        lines[count++] = rps
    }

    END {
        # Если данных вообще нет, выводим 0 и выходим
        if (count == 0) {
            print "0"
            exit
        }

        warmup = 5
        cooldown = 5

        sum = 0
        total_elements = 0

        if (count <= (warmup + cooldown + 3)) {
            # Если лог слишком короткий, считаем по всем элементам
            for (i = 0; i < count; i++) {
                sum += lines[i]
                total_elements++
            }
        } else {
            # Считаем без прогрева и спада
            for (i = warmup; i < (count - cooldown); i++) {
                sum += lines[i]
                total_elements++
            }
        }

        # Выводим среднее значение как строго целое число
        if (total_elements > 0) {
            printf "%d\n", int(sum / total_elements)
        } else {
            print "0"
        }
    }
' "$1"
